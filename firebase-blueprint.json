        "tujuan": { "type": "string", "maxLength": 300 },
        "tanggalDipergunakan": { "type": "string", "format": "date", "maxLength": 32 },
        "bidang": { "type": "string", "maxLength": 128 },
        "keperluan": { "type": "string", "maxLength": 500 },
        "jamMulai": { "type": "string", "maxLength": 16 },
        "jamSelesai": { "type": "string", "maxLength": 16 },
        "durasiJam": { "type": "string", "maxLength": 64 },
        "pemohonEmployeeId": { "type": "string", "maxLength": 128 },
        "pemohonNama": { "type": "string", "maxLength": 256 },
        "pemohonNip": { "type": "string", "maxLength": 64 },
        "pemohonJabatan": { "type": "string", "maxLength": 256 },
        "atasanLangsungEmployeeId": { "type": "string", "maxLength": 128 },
