      "properties": {
        "judulTopik": { "type": "string", "maxLength": 300 },
        "leaderEmployeeId": { "type": "string", "maxLength": 128 },
        "namaLeader": { "type": "string", "maxLength": 256 },
        "bidang": { "type": "string", "maxLength": 128 },
        "tanggalPelaksanaan": { "type": "string", "format": "date", "maxLength": 32 },
        "lokasi": { "type": "string", "maxLength": 256 },
        "ringkasan": { "type": "string", "maxLength": 1000 },
        "evidenceUrl": { "type": "string", "maxLength": 1024 },
        "evidenceFileName": { "type": "string", "maxLength": 256 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["judulTopik", "namaLeader", "bidang", "tanggalPelaksanaan", "createdByUid", "createdAt", "updatedAt"]
    },
