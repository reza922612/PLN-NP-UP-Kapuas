rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isViewer() {
      return hasRole('viewer') || isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'unitId', 'employeeId', 'themePreference', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.role in ['super_admin', 'admin', 'viewer', 'employee'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
             (!('unitId' in data) || (data.unitId is string && data.unitId.size() <= 128)) &&
             (!('employeeId' in data) || data.employeeId == null || (data.employeeId is string && data.employeeId.size() <= 128)) &&
             (!('themePreference' in data) || data.themePreference in ['light', 'dark']);
    }

    function isValidBiometricCredential(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'credentialId', 'deviceName', 'rpId', 'authenticatorType', 'createdAt', 'lastUsedAt']) &&
             data.keys().hasOnly(['userId', 'email', 'credentialId', 'deviceName', 'rpId', 'authenticatorType', 'createdAt', 'lastUsedAt']) &&
             data.userId == userId &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.credentialId is string && data.credentialId.size() > 0 && data.credentialId.size() <= 512 &&
             data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 128 &&
             data.rpId is string && data.rpId.size() > 0 && data.rpId.size() <= 256 &&
             data.authenticatorType == 'platform' &&
             data.createdAt is timestamp &&
             data.lastUsedAt is timestamp;
    }

    function isValidDismissedBroadcast(data, userId, announcementId) {
      return data.keys().hasAll(['userId', 'announcementId', 'dismissedAt']) &&
             data.keys().hasOnly(['userId', 'announcementId', 'dismissedAt']) &&
             data.userId == userId &&
             data.announcementId == announcementId &&
             data.dismissedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Users can see their own role to bootstrap UI
      allow list: if isAdmin();
      
      // Only super_admin can create/update roles
      // BOOTSTRAP: Allow current user email to register as super_admin
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) && incoming().uid == userId && (
        incoming().role == 'viewer' || 
        (request.auth.token.email == 'rzardiansyah92@gmail.com' && incoming().role == 'super_admin')
      );
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'themePreference', 'updatedAt'])
        ) ||
        hasRole('super_admin')
      );

      // WebAuthn Biometric Credentials (Owner-only)
      match /biometric_credentials/{credDocId} {
        allow get: if isValidId(userId) && isValidId(credDocId) && isSignedIn() && request.auth.uid == userId;
        allow list: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
        allow create: if isValidId(userId) && isValidId(credDocId) && isSignedIn() &&
                      request.auth.uid == userId &&
                      exists(/databases/$(database)/documents/users/$(userId)) &&
                      isValidBiometricCredential(incoming(), userId) &&
                      incoming().createdAt == request.time &&
                      incoming().lastUsedAt == request.time;
        allow update: if isValidId(userId) && isValidId(credDocId) && isSignedIn() &&
                      request.auth.uid == userId &&
                      exists(/databases/$(database)/documents/users/$(userId)) &&
                      isValidBiometricCredential(incoming(), userId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastUsedAt']) &&
                      incoming().lastUsedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(credDocId) && isSignedIn() && request.auth.uid == userId;
      }

      // Dismissed Broadcast Toast Receipts (Owner-only)
      match /dismissed_broadcasts/{announcementId} {
        allow get: if isValidId(userId) && isValidId(announcementId) && isSignedIn() && request.auth.uid == userId;
        allow list: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
        allow create, update: if isValidId(userId) && isValidId(announcementId) && isSignedIn() &&
                              request.auth.uid == userId &&
                              exists(/databases/$(database)/documents/users/$(userId)) &&
                              isValidDismissedBroadcast(incoming(), userId, announcementId) &&
                              incoming().dismissedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(announcementId) && isSignedIn() && request.auth.uid == userId;
      }
    }

    // 2. Employees Collection
    function isValidEmployee(data) {
      return data.nip is string && data.nip.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 256 &&
             data.unitPelaksana is string &&
             data.perusahaan is string &&
             data.status in ['Pegawai Organik', 'Pegawai Tugas Khusus', 'Tenaga Alih Daya'] &&
             (!('agama' in data) || (data.agama is string && data.agama.size() <= 50)) &&
             (!('familyMembers' in data) || (
               data.familyMembers is list &&
               data.familyMembers.size() <= 30 &&
               (data.familyMembers.size() == 0 || (
                 data.familyMembers[0] is map &&
                 data.familyMembers[0].nama is string && data.familyMembers[0].nama.size() > 0 && data.familyMembers[0].nama.size() <= 256 &&
                 data.familyMembers[0].hubunganKeluarga in ['Istri/Suami', 'Anak Kandung'] &&
                 data.familyMembers[0].tanggalLahir is string && data.familyMembers[0].tanggalLahir.size() <= 32 &&
                 data.familyMembers[0].jenisKelamin in ['Laki-laki', 'Perempuan'] &&
                 data.familyMembers[0].jaminanKesehatan in ['Dijamin', 'Tidak Dijamin'] &&
                 (!('noKPS' in data.familyMembers[0]) || (data.familyMembers[0].noKPS is string && data.familyMembers[0].noKPS.size() <= 128))
               ))
             ));
    }

    match /employees/{employeeId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidEmployee(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidEmployee(incoming()) && (
        incoming().nip == existing().nip && // NIP Immutable
        incoming().updatedAt == request.time
      );
      allow delete: if hasRole('super_admin');

      // Sub-collections: Trainings & Certifications
      match /trainings/{trainingId} {
        allow read: if isViewer();
        allow write: if isAdmin();
      }
      match /certifications/{certId} {
        allow read: if isViewer();
        allow write: if isAdmin();
      }
    }

    // 3. Metadata Collections
    function isValidUnit(data) {
      return data.namaUnitLayananPusatListrik is string && data.namaUnitLayananPusatListrik.size() <= 256 &&
             data.alamatLengkap is string && data.alamatLengkap.size() <= 1024 &&
             (!('latitude' in data) || data.latitude is number) &&
             (!('longitude' in data) || data.longitude is number) &&
             (!('mesin' in data) || data.mesin is list) &&
             (!('photoUrl' in data) || (data.photoUrl == null || data.photoUrl is string)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /units/{unitId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidUnit(incoming());
      allow update: if isAdmin() && isValidUnit(incoming());
      allow delete: if hasRole('super_admin');
    }
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if hasRole('super_admin');
    }

    // 4. Activity Logs Collection (Immutable Audit Trail)
    function isValidActivityLog(data) {
      return data.keys().hasAll(['action', 'entityType', 'entityId', 'entityName', 'description', 'actorUid', 'actorEmail', 'actorName', 'createdAt']) &&
             data.keys().hasOnly(['action', 'entityType', 'entityId', 'entityName', 'description', 'actorUid', 'actorEmail', 'actorName', 'actorRole', 'createdAt']) &&
             data.action in ['CREATE', 'UPDATE', 'DELETE'] &&
             data.entityType in ['employee', 'unit', 'system', 'sppd'] &&
             data.entityId is string && data.entityId.size() > 0 && data.entityId.size() <= 128 &&
             data.entityName is string && data.entityName.size() > 0 && data.entityName.size() <= 256 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 512 &&
             data.actorUid is string && data.actorUid == request.auth.uid &&
             data.actorEmail is string && data.actorEmail.size() <= 256 &&
             data.actorName is string && data.actorName.size() <= 256 &&
             (!('actorRole' in data) || (data.actorRole is string && data.actorRole.size() <= 64)) &&
             data.createdAt == request.time;
    }

    match /activity_logs/{logId} {
      allow get: if isValidId(logId) && isViewer();
      allow list: if isViewer();
      allow create: if isValidId(logId) && isAdmin() && isValidActivityLog(incoming());
      allow update, delete: if false;
    }

    // 5. Public Employee ID Verification Collection (Non-PII, Single-Doc Get Only)
    function isValidPublicVerification(data, employeeId) {
      return data.keys().hasAll(['employeeId', 'fullName', 'nip', 'unitPelaksana', 'status', 'perusahaan', 'verifiedStatus', 'updatedAt']) &&
             data.keys().hasOnly(['employeeId', 'fullName', 'nip', 'jabatanLengkap', 'unitPelaksana', 'subUnit', 'status', 'perusahaan', 'photoUrl', 'verifiedStatus', 'updatedAt']) &&
             data.employeeId == employeeId &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 256 &&
             data.nip is string && data.nip.size() > 0 && data.nip.size() <= 64 &&
             (!('jabatanLengkap' in data) || (data.jabatanLengkap is string && data.jabatanLengkap.size() <= 256)) &&
             data.unitPelaksana is string && data.unitPelaksana.size() <= 256 &&
             (!('subUnit' in data) || (data.subUnit is string && data.subUnit.size() <= 256)) &&
             data.status in ['Pegawai Organik', 'Pegawai Tugas Khusus', 'Tenaga Alih Daya'] &&
             data.perusahaan is string && data.perusahaan.size() <= 256 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1024)) &&
             data.verifiedStatus in ['ACTIVE', 'INACTIVE'] &&
             data.updatedAt == request.time;
    }

    match /public_verifications/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if false;
      allow create, update: if isValidId(employeeId) && isAdmin() &&
                            isValidPublicVerification(incoming(), employeeId) &&
                            exists(/databases/$(database)/documents/employees/$(employeeId));
      allow delete: if isValidId(employeeId) && hasRole('super_admin');
    }

    // 6. Public Non-PII Aggregated Command Center Statistics
    function isValidPublicStats(data, statId) {
      return data.keys().hasAll(['statId', 'totalEmployees', 'organicCount', 'taskForceCount', 'subcontractCount', 'totalUnits', 'totalMachines', 'totalCapacityKW', 'totalPeakLoadKW', 'updatedAt']) &&
             data.keys().hasOnly(['statId', 'totalEmployees', 'organicCount', 'taskForceCount', 'subcontractCount', 'totalUnits', 'totalMachines', 'totalCapacityKW', 'totalPeakLoadKW', 'systemBreakdown', 'machineTypeBreakdown', 'unitSummaries', 'updatedAt']) &&
             data.statId == statId &&
             data.totalEmployees is number && data.totalEmployees >= 0 &&
             data.organicCount is number && data.organicCount >= 0 &&
             data.taskForceCount is number && data.taskForceCount >= 0 &&
             data.subcontractCount is number && data.subcontractCount >= 0 &&
             data.totalUnits is number && data.totalUnits >= 0 &&
             data.totalMachines is number && data.totalMachines >= 0 &&
             data.totalCapacityKW is number && data.totalCapacityKW >= 0 &&
             data.totalPeakLoadKW is number && data.totalPeakLoadKW >= 0 &&
             (!('systemBreakdown' in data) || data.systemBreakdown is map) &&
             (!('machineTypeBreakdown' in data) || data.machineTypeBreakdown is map) &&
             (!('unitSummaries' in data) || (data.unitSummaries is list && data.unitSummaries.size() <= 50)) &&
             data.updatedAt == request.time;
    }

    match /public_stats/{statId} {
      allow get: if isValidId(statId);
      allow list: if false;
      allow create, update: if isValidId(statId) && isAdmin() && isValidPublicStats(incoming(), statId);
      allow delete: if isValidId(statId) && hasRole('super_admin');
    }

    // 7. SPPD Travel Requests Collection
    function isValidSppdBidang(bidang) {
      return bidang in [
        'Manager UP',
        'Bidang Operasi',
        'Bidang Operasi - Rendal Operasi dan Niaga',
        'Bidang Operasi - Bahan Bakar',
        'Bidang Pemeliharaan',
        'Bidang Pemeliharaan - Rendal Pemeliharaan',
        'Bidang Pemeliharaan - Management Outage',
        'Bidang Pemeliharaan - Inventory Control dan Gudang',
        'Bidang Engineering',
        'Bidang Engineering - System Owner',
        'Bidang Engineering - Manajemen Mutu, Risiko dan Kepatuhan',
        'Bidang Engineering - Condition Based Maintenance',
        'Bidang Business Support',
        'Bidang Business Support - Keuangan dan Akuntansi',
        'Bidang Business Support - SDM, Umum dan CSR',
        'Bidang Business Support - Pengadaan',
        'Bidang K3 dan Keamanan',
        'Bidang Lingkungan',
        'Manager UL',
        'Bidang Operasi UL',
        'Bidang Pemeliharaan UL',
        'Bidang K3, Lingkungan dan Keamanan UL',
        'Bidang Operasi dan Pemeliharaan UL'
      ];
    }

    function isValidSppdRequest(data) {
      return data.keys().hasAll([
               'requestNumber', 'applicantUid', 'applicantEmail', 'namaPegawai', 'nip',
               'jabatan', 'bidang', 'unitKerja', 'jenisSppd', 'judulPerjalanan',
               'tanggalKeberangkatan', 'tanggalKembali', 'nomorPrk', 'nomorCoa',
               'jenisTransportasi', 'kotaKeberangkatan', 'kotaTujuan',
               'dokumenPendukung', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'requestNumber', 'applicantUid', 'applicantEmail', 'employeeId',
               'namaPegawai', 'nip', 'jabatan', 'bidang', 'unitKerja', 'jenisSppd',
               'judulPerjalanan', 'tanggalKeberangkatan', 'tanggalKembali',
               'nomorPrk', 'nomorCoa', 'jenisTransportasi', 'kotaKeberangkatan',
               'kotaTujuan', 'dokumenPendukung', 'status', 'approvalNotes',
               'approvedByName', 'approvedByUid', 'submittedAt', 'createdAt', 'updatedAt'
             ]) &&
             data.requestNumber is string && data.requestNumber.size() > 0 && data.requestNumber.size() <= 64 &&
             data.applicantUid is string && data.applicantUid.size() > 0 && data.applicantUid.size() <= 128 &&
             data.applicantEmail is string && data.applicantEmail.size() > 0 && data.applicantEmail.size() <= 256 &&
             (!('employeeId' in data) || data.employeeId == null || (data.employeeId is string && data.employeeId.size() <= 128)) &&
             data.namaPegawai is string && data.namaPegawai.size() > 0 && data.namaPegawai.size() <= 256 &&
             data.nip is string && data.nip.size() > 0 && data.nip.size() <= 64 &&
             data.jabatan is string && data.jabatan.size() > 0 && data.jabatan.size() <= 256 &&
             isValidSppdBidang(data.bidang) &&
             data.unitKerja in ['UP Kapuas', 'ULPLTD Sei Raya', 'ULPLTG/D Siantan', 'ULPLTD Sanggau dan Sintang', 'ULPLTD Ketapang'] &&
             data.jenisSppd in ['SPPD Diklat', 'SPPD Non Diklat'] &&
             data.judulPerjalanan is string && data.judulPerjalanan.size() > 0 && data.judulPerjalanan.size() <= 300 &&
             data.tanggalKeberangkatan is string && data.tanggalKeberangkatan.size() > 0 && data.tanggalKeberangkatan.size() <= 32 &&
             data.tanggalKembali is string && data.tanggalKembali.size() > 0 && data.tanggalKembali.size() <= 32 &&
             data.nomorPrk is string && data.nomorPrk.size() > 0 && data.nomorPrk.size() <= 128 &&
             data.nomorCoa is string && data.nomorCoa.size() > 0 && data.nomorCoa.size() <= 128 &&
             data.jenisTransportasi in ['Pesawat (Angkutan Udara)', 'Bus / Taksi (Angkutan Darat)', 'Kendaraan Dinas'] &&
             data.kotaKeberangkatan is string && data.kotaKeberangkatan.size() > 0 && data.kotaKeberangkatan.size() <= 128 &&
             data.kotaTujuan is string && data.kotaTujuan.size() > 0 && data.kotaTujuan.size() <= 128 &&
             data.dokumenPendukung is list && data.dokumenPendukung.size() <= 10 &&
             data.status in ['Draft', 'Submitted', 'Menunggu Approval', 'Approved', 'Rejected', 'Completed'] &&
             (!('approvalNotes' in data) || data.approvalNotes == null || (data.approvalNotes is string && data.approvalNotes.size() <= 512)) &&
             (!('approvedByName' in data) || data.approvedByName == null || (data.approvedByName is string && data.approvedByName.size() <= 256)) &&
             (!('approvedByUid' in data) || data.approvedByUid == null || (data.approvedByUid is string && data.approvedByUid.size() <= 128)) &&
             (!('submittedAt' in data) || data.submittedAt == null || data.submittedAt is timestamp) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /sppd_requests/{sppdId} {
      allow get: if isValidId(sppdId) && (isViewer() || (isSignedIn() && existing().applicantUid == request.auth.uid));
      allow list: if isViewer() || (isSignedIn() && resource.data.applicantUid == request.auth.uid);
      allow create: if isValidId(sppdId) && isSignedIn() &&
                    isValidSppdRequest(incoming()) &&
                    incoming().applicantUid == request.auth.uid &&
                    incoming().status in ['Draft', 'Submitted', 'Menunggu Approval'] &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    (!('approvedByUid' in incoming()) || incoming().approvedByUid == null) &&
                    (!('approvedByName' in incoming()) || incoming().approvedByName == null);
      allow update: if isValidId(sppdId) && isSignedIn() &&
                    isValidSppdRequest(incoming()) &&
                    incoming().applicantUid == existing().applicantUid &&
                    incoming().requestNumber == existing().requestNumber &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time && (
                      (
                        existing().applicantUid == request.auth.uid &&
                        existing().status in ['Draft', 'Rejected'] &&
                        incoming().status in ['Draft', 'Submitted', 'Menunggu Approval'] &&
                        (!('approvedByUid' in incoming()) || incoming().approvedByUid == existing().get('approvedByUid', null))
                      ) ||
                      isAdmin()
                    );
      allow delete: if isValidId(sppdId) && (
                      hasRole('super_admin') ||
                      (isSignedIn() && existing().applicantUid == request.auth.uid && existing().status == 'Draft')
                    );
    }

    // 8. In-App Broadcast Announcements Collection
    function isValidBroadcastAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'priority', 'isActive', 'senderUid', 'senderName', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['title', 'message', 'priority', 'isActive', 'senderUid', 'senderName', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.priority in ['info', 'important', 'urgent'] &&
             data.isActive is bool &&
             data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 256 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /broadcast_announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn() && (existing().isActive == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow create: if isValidId(announcementId) && isAdmin() &&
                    isValidBroadcastAnnouncement(incoming()) &&
                    incoming().senderUid == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isValidId(announcementId) && isAdmin() &&
                    isValidBroadcastAnnouncement(incoming()) &&
                    incoming().senderUid == existing().senderUid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'priority', 'isActive', 'updatedAt']);
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // 9. Firestore File Storage Collection (Fallback/Primary when Storage bucket is unavailable)
    function isValidStoredFile(data, fileId) {
      return data.keys().hasAll(['fileId', 'fileName', 'mimeType', 'sizeBytes', 'category', 'isPublic', 'chunkCount', 'inlineData', 'uploadedByUid', 'createdAt']) &&
             data.keys().hasOnly(['fileId', 'fileName', 'mimeType', 'sizeBytes', 'category', 'isPublic', 'chunkCount', 'inlineData', 'uploadedByUid', 'createdAt']) &&
             data.fileId == fileId &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 256 &&
             data.mimeType is string && data.mimeType.size() > 0 && data.mimeType.size() <= 128 &&
             data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 52428800 &&
             data.category in ['photo', 'dossier', 'training_cert', 'certification_cert', 'scan_doc', 'unit_photo', 'sppd_attachment'] &&
             data.isPublic is bool &&
             data.chunkCount is number && data.chunkCount >= 0 && data.chunkCount <= 120 &&
             ((data.chunkCount == 0 && data.inlineData is string && data.inlineData.size() <= 750000) ||
              (data.chunkCount > 0 && data.inlineData == null)) &&
             data.uploadedByUid is string && data.uploadedByUid.size() > 0 && data.uploadedByUid.size() <= 128 &&
             data.createdAt is timestamp;
    }

    function getStoredFileParent(fileId) {
      return get(/databases/$(database)/documents/stored_files/$(fileId)).data;
    }

    function isValidStoredFileChunk(data, fileId) {
      return data.keys().hasAll(['fileId', 'index', 'data', 'uploadedByUid']) &&
             data.keys().hasOnly(['fileId', 'index', 'data', 'uploadedByUid']) &&
             data.fileId == fileId &&
             data.index is number && data.index >= 0 && data.index < 120 &&
             data.data is string && data.data.size() > 0 && data.data.size() <= 800000 &&
             data.uploadedByUid is string && data.uploadedByUid.size() > 0 && data.uploadedByUid.size() <= 128;
    }

    match /stored_files/{fileId} {
      allow get: if isValidId(fileId) && (
        existing().isPublic == true ||
        isViewer() ||
        (isSignedIn() && existing().uploadedByUid == request.auth.uid)
      );
      allow list: if false;
      allow create: if isValidId(fileId) && isSignedIn() &&
                    isValidStoredFile(incoming(), fileId) &&
                    incoming().uploadedByUid == request.auth.uid &&
                    incoming().createdAt == request.time && (
                      incoming().isPublic == false ||
                      (isAdmin() && incoming().category in ['photo', 'unit_photo'])
                    );
      allow update: if false;
      allow delete: if isValidId(fileId) && (
        isAdmin() ||
        (isSignedIn() && existing().uploadedByUid == request.auth.uid)
      );

      match /chunks/{chunkId} {
        allow get: if isValidId(fileId) && isValidId(chunkId) &&
                   exists(/databases/$(database)/documents/stored_files/$(fileId)) && (
                     getStoredFileParent(fileId).isPublic == true ||
                     isViewer() ||
                     (isSignedIn() && getStoredFileParent(fileId).uploadedByUid == request.auth.uid)
                   );
        allow list: if false;
        allow create: if isValidId(fileId) && isValidId(chunkId) && isSignedIn() &&
                      isValidStoredFileChunk(incoming(), fileId) &&
                      incoming().uploadedByUid == request.auth.uid &&
                      exists(/databases/$(database)/documents/stored_files/$(fileId)) &&
                      getStoredFileParent(fileId).uploadedByUid == request.auth.uid &&
                      incoming().index < getStoredFileParent(fileId).chunkCount;
        allow update: if false;
        allow delete: if isValidId(fileId) && isValidId(chunkId) && (
          isAdmin() ||
          (isSignedIn() && exists(/databases/$(database)/documents/stored_files/$(fileId)) &&
           getStoredFileParent(fileId).uploadedByUid == request.auth.uid)
        );
      }
    }
  }
}
