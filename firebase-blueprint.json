        "imageFileName": { "type": "string", "maxLength": 256 },
        "attachmentUrl": { "type": "string", "maxLength": 1024 },
        "attachmentFileName": { "type": "string", "maxLength": 256 },
        "isPublished": { "type": "boolean" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "kategori",
        "judul",
        "tanggalKegiatan",
        "lokasi",
        "ringkasan",
        "konten",
        "isPublished",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
