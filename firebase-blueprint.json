        "rejectionReason": { "type": "string", "maxLength": 512 },
        "isTrackingActive": { "type": "boolean" },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" },
        "currentSpeedKmh": { "type": "number" },
        "lastLocationLabel": { "type": "string", "maxLength": 256 },
        "trackingUpdatedAt": { "type": "string", "maxLength": 64 },
        "trackingHistory": { "type": "array" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "loanNumber", "nama", "jumlahPenumpang", "tujuan", "tanggalDipergunakan", "bidang",
        "keperluan", "jamMulai", "jamSelesai", "durasiJam", "pemohonNama",
        "atasanLangsungNama", "asmanBisnisSupportNama", "status", "createdByUid", "createdByEmail",
        "createdAt", "updatedAt"
      ]
    },
