# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps features.
GOOGLE_MAPS_PLATFORM_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Official SIMAP WhatsApp Sender Number
WHATSAPP_SENDER_NUMBER="085111320701"

# WHATSAPP_PROVIDER: Optional ("meta" | "fonnte" | "wablas" | "generic").
# Auto-detected if Meta or Gateway credentials are provided.
WHATSAPP_PROVIDER=

# Meta WhatsApp Business Cloud API (official API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION="v21.0"

# Official WhatsApp Gateway provider (if using gateway instead of Meta Cloud API)
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# Optional: Backend Node.js base URL when frontend is served from a separate static host
VITE_API_BASE_URL=
# Optional: Comma-separated allowed frontend origins for CORS on /api/*
CORS_ALLOWED_ORIGIN=

