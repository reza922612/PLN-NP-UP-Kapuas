rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isViewer() {
      return hasRole('viewer') || isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'unitId', 'employeeId', 'themePreference', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.role in ['super_admin', 'admin', 'viewer', 'employee'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
             (!('unitId' in data) || (data.unitId is string && data.unitId.size() <= 128)) &&
             (!('employeeId' in data) || data.employeeId == null || (data.employeeId is string && data.employeeId.size() <= 128)) &&
             (!('themePreference' in data) || data.themePreference in ['light', 'dark']);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Users can see their own role to bootstrap UI
      allow list: if isAdmin();
      
      // Only super_admin can create/update roles
      // BOOTSTRAP: Allow current user email to register as super_admin
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) && incoming().uid == userId && (
        incoming().role == 'viewer' || 
        (request.auth.token.email == 'rzardiansyah92@gmail.com' && incoming().role == 'super_admin')
      );
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'themePreference', 'updatedAt'])
        ) ||
        hasRole('super_admin')
      );
    }

    // 2. Employees Collection
    function isValidEmployee(data) {
      return data.nip is string && data.nip.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 256 &&
             data.unitPelaksana is string &&
             data.perusahaan is string &&
             data.status in ['Pegawai Organik', 'Pegawai Tugas Khusus', 'Tenaga Alih Daya'] &&
             (!('agama' in data) || (data.agama is string && data.agama.size() <= 50));
    }

    match /employees/{employeeId} {
      allow read: if isViewer();
      allow create: if isAdmin() && isValidEmployee(incoming()) && 
                    incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidEmployee(incoming()) && (
        incoming().nip == existing().nip && // NIP Immutable
        incoming().updatedAt == request.time
      );
      allow delete: if hasRole('super_admin');

      // Sub-collections: Trainings & Certifications
      match /trainings/{trainingId} {
        allow read: if isViewer();
        allow write: if isAdmin();
      }
      match /certifications/{certId} {
        allow read: if isViewer();
        allow write: if isAdmin();
      }
    }

    // 3. Metadata Collections
    function isValidUnit(data) {
      return data.namaUnitLayananPusatListrik is string && data.namaUnitLayananPusatListrik.size() <= 256 &&
             data.alamatLengkap is string && data.alamatLengkap.size() <= 1024 &&
             (!('latitude' in data) || data.latitude is number) &&
             (!('longitude' in data) || data.longitude is number) &&
             (!('mesin' in data) || data.mesin is list) &&
             (!('photoUrl' in data) || (data.photoUrl == null || data.photoUrl is string)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /units/{unitId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidUnit(incoming());
      allow update: if isAdmin() && isValidUnit(incoming());
      allow delete: if hasRole('super_admin');
    }
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if hasRole('super_admin');
    }

    // 4. Activity Logs Collection (Immutable Audit Trail)
    function isValidActivityLog(data) {
      return data.keys().hasAll(['action', 'entityType', 'entityId', 'entityName', 'description', 'actorUid', 'actorEmail', 'actorName', 'createdAt']) &&
             data.keys().hasOnly(['action', 'entityType', 'entityId', 'entityName', 'description', 'actorUid', 'actorEmail', 'actorName', 'actorRole', 'createdAt']) &&
             data.action in ['CREATE', 'UPDATE', 'DELETE'] &&
             data.entityType in ['employee', 'unit', 'system'] &&
             data.entityId is string && data.entityId.size() > 0 && data.entityId.size() <= 128 &&
             data.entityName is string && data.entityName.size() > 0 && data.entityName.size() <= 256 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 512 &&
             data.actorUid is string && data.actorUid == request.auth.uid &&
             data.actorEmail is string && data.actorEmail.size() <= 256 &&
             data.actorName is string && data.actorName.size() <= 256 &&
             (!('actorRole' in data) || (data.actorRole is string && data.actorRole.size() <= 64)) &&
             data.createdAt == request.time;
    }

    match /activity_logs/{logId} {
      allow get: if isValidId(logId) && isViewer();
      allow list: if isViewer();
      allow create: if isValidId(logId) && isAdmin() && isValidActivityLog(incoming());
      allow update, delete: if false;
    }

    // 5. Public Employee ID Verification Collection (Non-PII, Single-Doc Get Only)
    function isValidPublicVerification(data, employeeId) {
      return data.keys().hasAll(['employeeId', 'fullName', 'nip', 'unitPelaksana', 'status', 'perusahaan', 'verifiedStatus', 'updatedAt']) &&
             data.keys().hasOnly(['employeeId', 'fullName', 'nip', 'jabatanLengkap', 'unitPelaksana', 'subUnit', 'status', 'perusahaan', 'photoUrl', 'verifiedStatus', 'updatedAt']) &&
             data.employeeId == employeeId &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 256 &&
             data.nip is string && data.nip.size() > 0 && data.nip.size() <= 64 &&
             (!('jabatanLengkap' in data) || (data.jabatanLengkap is string && data.jabatanLengkap.size() <= 256)) &&
             data.unitPelaksana is string && data.unitPelaksana.size() <= 256 &&
             (!('subUnit' in data) || (data.subUnit is string && data.subUnit.size() <= 256)) &&
             data.status in ['Pegawai Organik', 'Pegawai Tugas Khusus', 'Tenaga Alih Daya'] &&
             data.perusahaan is string && data.perusahaan.size() <= 256 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1024)) &&
             data.verifiedStatus in ['ACTIVE', 'INACTIVE'] &&
             data.updatedAt == request.time;
    }

    match /public_verifications/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if false;
      allow create, update: if isValidId(employeeId) && isAdmin() &&
                            isValidPublicVerification(incoming(), employeeId) &&
                            exists(/databases/$(database)/documents/employees/$(employeeId));
      allow delete: if isValidId(employeeId) && hasRole('super_admin');
    }

    // 6. Public Non-PII Aggregated Command Center Statistics
    function isValidPublicStats(data, statId) {
      return data.keys().hasAll(['statId', 'totalEmployees', 'organicCount', 'taskForceCount', 'subcontractCount', 'totalUnits', 'totalMachines', 'totalCapacityKW', 'totalPeakLoadKW', 'updatedAt']) &&
             data.keys().hasOnly(['statId', 'totalEmployees', 'organicCount', 'taskForceCount', 'subcontractCount', 'totalUnits', 'totalMachines', 'totalCapacityKW', 'totalPeakLoadKW', 'systemBreakdown', 'machineTypeBreakdown', 'unitSummaries', 'updatedAt']) &&
             data.statId == statId &&
             data.totalEmployees is number && data.totalEmployees >= 0 &&
             data.organicCount is number && data.organicCount >= 0 &&
             data.taskForceCount is number && data.taskForceCount >= 0 &&
             data.subcontractCount is number && data.subcontractCount >= 0 &&
             data.totalUnits is number && data.totalUnits >= 0 &&
             data.totalMachines is number && data.totalMachines >= 0 &&
             data.totalCapacityKW is number && data.totalCapacityKW >= 0 &&
             data.totalPeakLoadKW is number && data.totalPeakLoadKW >= 0 &&
             (!('systemBreakdown' in data) || data.systemBreakdown is map) &&
             (!('machineTypeBreakdown' in data) || data.machineTypeBreakdown is map) &&
             (!('unitSummaries' in data) || (data.unitSummaries is list && data.unitSummaries.size() <= 50)) &&
             data.updatedAt == request.time;
    }

    match /public_stats/{statId} {
      allow get: if isValidId(statId);
      allow list: if false;
      allow create, update: if isValidId(statId) && isAdmin() && isValidPublicStats(incoming(), statId);
      allow delete: if isValidId(statId) && hasRole('super_admin');
    }
  }
}
