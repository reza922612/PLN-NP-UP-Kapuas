{
  "entities": {
    "User": {
      "title": "User",
      "description": "System administrator, employee, or viewer",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "viewer", "employee"] },
        "unitId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "themePreference": { "type": "string", "enum": ["light", "dark"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Detailed employee data",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "nip": { "type": "string" },
        "unitPelaksana": { "type": "string" },
        "subUnit": { "type": "string" },
        "jabatanLengkap": { "type": "string" },
        "atasanId": { "type": "string", "maxLength": 128, "description": "ID pegawai atasan langsung untuk sinkronisasi Struktur Organisasi" },
        "atasanNama": { "type": "string", "maxLength": 256, "description": "Nama atasan langsung pegawai" },
        "atasanJabatan": { "type": "string", "maxLength": 256, "description": "Jabatan atasan langsung pegawai" },
        "personGrade": { "type": "string" },
        "positionGrade": { "type": "string" },
        "tanggalMasuk": { "type": "string", "format": "date" },
        "tanggalCalonPegawai": { "type": "string", "format": "date" },
        "emailKorporat": { "type": "string", "format": "email" },
        "alamatLengkap": { "type": "string" },
        "tanggalLahir": { "type": "string", "format": "date" },
        "tanggalMulaiJabatan": { "type": "string", "format": "date" },
        "masaJabatan": { "type": "string", "maxLength": 64, "description": "Masa jabatan terhitung otomatis dari tanggal mulai jabatan" },
        "tanggalPengangkatan": { "type": "string", "format": "date" },
        "tanggalBerakhirBekerja": { "type": "string", "format": "date" },
        "tanggalPensiunNormal": { "type": "string", "format": "date" },
        "jenisKelamin": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "agama": { "type": "string" },
        "noTelepon": { "type": "string" },
        "noNPWP": { "type": "string" },
        "noKTP": { "type": "string" },
        "noBPJSKesehatan": { "type": "string" },
        "noBPJSKetenagakerjaan": { "type": "string" },
        "noKPS": { "type": "string", "maxLength": 128, "description": "Nomor Kartu Pegawai Sehat (KPS) pegawai" },
        "pendidikanTerakhir": { "type": "string" },
        "status": { "type": "string", "enum": ["Pegawai Organik", "Pegawai Tugas Khusus", "Tenaga Alih Daya"] },
        "perusahaan": { "type": "string", "enum": ["PT PLN Nusantara Power", "PT PLN (Persero)", "PT PLN Paguntaka Cahaya Nusantara", "PT Mitra Karya Prima"] },
        "photoUrl": { "type": "string" },
        "dossierUrl": { "type": "string" },
        "familyMembers": { "type": "array", "description": "Daftar anggota keluarga pegawai" },
        "scannedDocuments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nip", "fullName", "unitPelaksana", "status", "perusahaan"]
    },
    "Training": {
      "title": "Training",
      "description": "Employee training history",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "employeeId": { "type": "string" }
      }
    },
    "Certification": {
      "title": "Certification",
      "description": "Employee certification history",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "issueDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string", "format": "date" },
        "certificateUrl": { "type": "string" },
        "employeeId": { "type": "string" }
      }
    },
    "Machine": {
      "title": "Machine",
      "description": "Generator machine details",
      "type": "object",
      "properties": {
        "namaMesin": { "type": "string" },
        "typeMesin": { "type": "string" },
        "nomorSeri": { "type": "string" },
        "dayaMampuNominal": { "type": "number" },
        "bebanPuncak": { "type": "number" },
        "jenisMesin": { "type": "string", "enum": ["PLTD", "PLTG", "PLTU"] },
        "sistem": { "type": "string", "enum": ["Sistem Khatulistiwa", "Sistem Ketapang", "Sistem Putusibau"] }
      }
    },
    "Unit": {
      "title": "Unit",
      "description": "PLN NP Units",
      "type": "object",
      "properties": {
        "namaUnitLayananPusatListrik": { "type": "string" },
        "alamatLengkap": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "photoUrl": { "type": "string" },
        "mesin": { 
          "type": "array"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["namaUnitLayananPusatListrik", "alamatLengkap"]
    },
    "Company": {
      "title": "Company",
      "description": "PLN NP Group Companies",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail of administrative actions on employees and units",
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE"] },
        "entityType": { "type": "string", "enum": ["employee", "unit", "system", "sppd", "knowledge", "publikasi", "vehicle"] },
        "entityId": { "type": "string", "maxLength": 128 },
        "entityName": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 512 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "actorName": { "type": "string", "maxLength": 256 },
        "actorRole": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "entityType", "entityId", "entityName", "description", "actorUid", "actorEmail", "actorName", "createdAt"]
    },
    "PublicVerification": {
      "title": "PublicVerification",
      "description": "Public non-PII employee ID verification card accessed via QR code",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 256 },
        "nip": { "type": "string", "maxLength": 64 },
        "jabatanLengkap": { "type": "string", "maxLength": 256 },
        "unitPelaksana": { "type": "string", "maxLength": 256 },
        "subUnit": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["Pegawai Organik", "Pegawai Tugas Khusus", "Tenaga Alih Daya"] },
        "perusahaan": { "type": "string", "maxLength": 256 },
        "photoUrl": { "type": "string", "maxLength": 1024 },
        "verifiedStatus": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "fullName", "nip", "unitPelaksana", "status", "perusahaan", "verifiedStatus", "updatedAt"]
    },
    "PublicStats": {
      "title": "PublicStats",
      "description": "Non-PII aggregated workforce and power generation statistics for the public landing page",
      "type": "object",
      "properties": {
        "statId": { "type": "string", "maxLength": 128 },
        "totalEmployees": { "type": "number" },
        "organicCount": { "type": "number" },
        "taskForceCount": { "type": "number" },
        "subcontractCount": { "type": "number" },
        "totalUnits": { "type": "number" },
        "totalMachines": { "type": "number" },
        "totalCapacityKW": { "type": "number" },
        "totalPeakLoadKW": { "type": "number" },
        "systemBreakdown": { "type": "object" },
        "machineTypeBreakdown": { "type": "object" },
        "unitSummaries": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["statId", "totalEmployees", "organicCount", "taskForceCount", "subcontractCount", "totalUnits", "totalMachines", "totalCapacityKW", "totalPeakLoadKW", "updatedAt"]
    },
    "BiometricCredential": {
      "title": "BiometricCredential",
      "description": "WebAuthn platform authenticator metadata registered per user device",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "credentialId": { "type": "string", "maxLength": 512 },
        "deviceName": { "type": "string", "maxLength": 128 },
        "rpId": { "type": "string", "maxLength": 256 },
        "authenticatorType": { "type": "string", "enum": ["platform"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "credentialId", "deviceName", "rpId", "authenticatorType", "createdAt", "lastUsedAt"]
    },
    "SppdRequest": {
      "title": "SppdRequest",
      "description": "Digital Surat Perjalanan Dinas (SPPD) submission and approval workflow record",
      "type": "object",
      "properties": {
        "requestNumber": { "type": "string", "maxLength": 64 },
        "applicantUid": { "type": "string", "maxLength": 128 },
        "applicantEmail": { "type": "string", "format": "email", "maxLength": 256 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "namaPegawai": { "type": "string", "maxLength": 256 },
        "nip": { "type": "string", "maxLength": 64 },
        "jabatan": { "type": "string", "maxLength": 256 },
        "bidang": {
          "type": "string",
          "enum": [
            "Manager UP",
            "Bidang Operasi",
            "Bidang Operasi - Rendal Operasi dan Niaga",
            "Bidang Operasi - Bahan Bakar",
            "Bidang Pemeliharaan",
            "Bidang Pemeliharaan - Rendal Pemeliharaan",
            "Bidang Pemeliharaan - Management Outage",
            "Bidang Pemeliharaan - Inventory Control dan Gudang",
            "Bidang Engineering",
            "Bidang Engineering - System Owner",
            "Bidang Engineering - Manajemen Mutu, Risiko dan Kepatuhan",
            "Bidang Engineering - Condition Based Maintenance",
            "Bidang Business Support",
            "Bidang Business Support - Keuangan dan Akuntansi",
            "Bidang Business Support - SDM, Umum dan CSR",
            "Bidang Business Support - Pengadaan",
            "Bidang K3 dan Keamanan",
            "Bidang Lingkungan",
            "Manager UL",
            "Bidang Operasi UL",
            "Bidang Pemeliharaan UL",
            "Bidang K3, Lingkungan dan Keamanan UL",
            "Bidang Operasi dan Pemeliharaan UL"
          ]
        },
        "unitKerja": {
          "type": "string",
          "enum": [
            "UP Kapuas",
            "ULPLTD Sei Raya",
            "ULPLTG/D Siantan",
            "ULPLTD Sanggau dan Sintang",
            "ULPLTD Ketapang"
          ]
        },
        "jenisSppd": { "type": "string", "enum": ["SPPD Diklat", "SPPD Non Diklat"] },
        "judulPerjalanan": { "type": "string", "maxLength": 300 },
        "tanggalKeberangkatan": { "type": "string", "format": "date", "maxLength": 32 },
        "tanggalKembali": { "type": "string", "format": "date", "maxLength": 32 },
        "nomorPrk": { "type": "string", "maxLength": 128 },
        "nomorCoa": { "type": "string", "maxLength": 128 },
        "jenisTransportasi": {
          "type": "string",
          "enum": [
            "Pesawat (Angkutan Udara)",
            "Bus / Taksi (Angkutan Darat)",
            "Kendaraan Dinas"
          ]
        },
        "kotaKeberangkatan": { "type": "string", "maxLength": 128 },
        "kotaTujuan": { "type": "string", "maxLength": 128 },
        "dokumenPendukung": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["Draft", "Submitted", "Menunggu Approval", "Approved", "Rejected", "Completed"]
        },
        "approvalNotes": { "type": "string", "maxLength": 512 },
        "approvedByName": { "type": "string", "maxLength": 256 },
        "approvedByUid": { "type": "string", "maxLength": 128 },
        "submittedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "requestNumber",
        "applicantUid",
        "applicantEmail",
        "namaPegawai",
        "nip",
        "jabatan",
        "bidang",
        "unitKerja",
        "jenisSppd",
        "judulPerjalanan",
        "tanggalKeberangkatan",
        "tanggalKembali",
        "nomorPrk",
        "nomorCoa",
        "jenisTransportasi",
        "kotaKeberangkatan",
        "kotaTujuan",
        "dokumenPendukung",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BroadcastAnnouncement": {
      "title": "BroadcastAnnouncement",
      "description": "Administrator in-app broadcast announcement displayed as a toast notification upon user login",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["info", "important", "urgent"] },
        "isActive": { "type": "boolean" },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "message",
        "priority",
        "isActive",
        "senderUid",
        "senderName",
        "createdAt",
        "updatedAt"
      ]
    },
    "DismissedBroadcast": {
      "title": "DismissedBroadcast",
      "description": "Per-user dismissal receipt for an active broadcast announcement toast",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "announcementId": { "type": "string", "maxLength": 128 },
        "dismissedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "announcementId", "dismissedAt"]
    },
    "StoredFile": {
      "title": "StoredFile",
      "description": "Uploaded file metadata and optional inline base64 payload for files stored directly in Firestore",
      "type": "object",
      "properties": {
        "fileId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 256 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "sizeBytes": { "type": "number" },
        "category": {
          "type": "string",
          "enum": [
            "photo",
            "dossier",
            "training_cert",
            "certification_cert",
            "scan_doc",
            "unit_photo",
            "sppd_attachment",
            "ksf_evidence",
            "cop_evidence",
            "inovasi_doc",
            "sop_doc",
            "regulasi_doc",
            "perdir_doc",
            "publication_media"
          ]
        },
        "isPublic": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "inlineData": { "type": "string", "maxLength": 750000 },
        "uploadedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileId", "fileName", "mimeType", "sizeBytes", "category", "isPublic", "chunkCount", "inlineData", "uploadedByUid", "createdAt"]
    },
    "StoredFileChunk": {
      "title": "StoredFileChunk",
      "description": "Binary base64 slice of a large uploaded file stored under stored_files/{fileId}/chunks",
      "type": "object",
      "properties": {
        "fileId": { "type": "string", "maxLength": 128 },
        "index": { "type": "number" },
        "data": { "type": "string", "maxLength": 800000 },
        "uploadedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["fileId", "index", "data", "uploadedByUid"]
    },
    "KnowledgeSharingForum": {
      "title": "KnowledgeSharingForum",
      "description": "Publicly visible Knowledge Sharing Forum execution record synced with employee presenters",
      "type": "object",
      "properties": {
        "pemateriEmployeeId": { "type": "string", "maxLength": 128 },
        "namaPemateri": { "type": "string", "maxLength": 256 },
        "pemateriNip": { "type": "string", "maxLength": 64 },
        "pemateriUnit": { "type": "string", "maxLength": 256 },
        "judulMateri": { "type": "string", "maxLength": 300 },
        "tanggalPelaksanaan": { "type": "string", "format": "date", "maxLength": 32 },
        "lokasiPelaksanaan": { "type": "string", "maxLength": 256 },
        "metodePelaksanaan": { "type": "string", "enum": ["Online", "Offline"] },
        "evidenceUrl": { "type": "string", "maxLength": 1024 },
        "evidenceFileName": { "type": "string", "maxLength": 256 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["namaPemateri", "judulMateri", "tanggalPelaksanaan", "lokasiPelaksanaan", "metodePelaksanaan", "createdByUid", "createdAt", "updatedAt"]
    },
    "CommunityOfPractice": {
      "title": "CommunityOfPractice",
      "description": "Internal Community of Practice records accessible to registered employees",
